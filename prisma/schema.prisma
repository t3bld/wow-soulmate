// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Field values are validated by profileSchema in src/lib/profile.ts.
model Profile {
  id           String   @id @default(uuid()) @db.Uuid
  subject      String   @unique
  bnetBattleTag String? @map("bnet_battle_tag") @db.VarChar(128)
  bnetEmail String? @map("bnet_email") @db.VarChar(254)
  bnetEmailVerified Boolean? @map("bnet_email_verified")
  bnetLastLoginAt DateTime? @map("bnet_last_login_at") @db.Timestamptz(3)
  alias        String
  about        String   @default("") @db.VarChar(1000)
  region       String
  language     String
  roles        String[]
  activities   String[]
  classes      String[] @default([])
  factions     String[] @default([])
  experience   String
  ageGroup     String   @map("age_group")
  timezone     String
  playtimes    ProfilePlaytime[]
  preferredClasses String[] @default([]) @map("preferred_classes")
  classPriority String @default("wish") @map("class_priority")
  rolePreference String @default("any") @map("role_preference")
  rolePriority String @default("wish") @map("role_priority")
  experiencePreference String @default("any") @map("experience_preference")
  experiencePriority String @default("wish") @map("experience_priority")
  adult        Boolean
  discoverable Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  wowImport    WowImport?

  @@index([discoverable, region, language])
  @@map("soulmate_profiles")
}

model ProfilePlaytime {
  profileId String @map("profile_id") @db.Uuid
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  position Int
  days Int[]
  startHour Int @map("start_hour")
  endHour Int @map("end_hour")

  @@id([profileId, position])
  @@map("soulmate_profile_playtimes")
}

model WowImport {
  subject     String   @id
  runId       String   @default(uuid()) @map("run_id") @db.Uuid
  profileId   String?  @unique @map("profile_id") @db.Uuid
  profile     Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  snapshot    Json
  startedAt   DateTime @map("started_at") @db.Timestamptz(3)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("soulmate_wow_imports")
}

model FeedbackRateLimit {
  key String @id @db.VarChar(64)
  nextAllowedAt DateTime @map("next_allowed_at") @db.Timestamptz(3)

  @@index([nextAllowedAt])
  @@map("soulmate_feedback_rate_limits")
}

model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  bnetSubject String @unique
  bnetBattleTag String?
  bnetEmail String?
  bnetEmailVerified Boolean?
  bnetLastLoginAt String?
  sessions Session[]
  accounts Account[]

  @@map("auth_users")
}

model Session {
  id String @id
  token String @unique
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope String?
  password String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_accounts")
}

model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
  @@map("auth_verifications")
}

model RateLimit {
  id String @id
  key String @unique
  count Int
  lastRequest BigInt

  @@map("auth_rate_limits")
}

model RequestRateLimit {
  key String @id @db.VarChar(64)
  count Int
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("soulmate_request_rate_limits")
}
